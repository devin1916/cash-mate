# ---------------------------------------------------------------
# CashMate backend environment configuration
# Copy this file to `server/.env` and fill in real values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------

# Application
NODE_ENV=development
PORT=4000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cashmate
DB_USER=cashmate
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Authentication
# Generate strong secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# CORS (comma separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173

# Uploads (profile pictures / receipts)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2

# Email delivery: "console" logs emails to the server terminal (dev),
# "smtp" sends real emails using the SMTP_* settings below.
EMAIL_TRANSPORT=console
EMAIL_FROM="CashMate <no-reply@cashmate.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Password reset link base URL (where the frontend reset page lives)
APP_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_RESET_MAX=5

# Initial admin account (used by `npm run seed`)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@cashmate.local
ADMIN_PASSWORD=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_RESET_MAX=5
